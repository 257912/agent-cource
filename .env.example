# 复制本文件为 .env 后填写真实值；.env 已在 .gitignore 中，绝不入库。
# 说明：Key 只存在于后端进程的环境变量里，前端永远拿不到。

# 大模型（OpenAI 兼容协议，DeepSeek / 通义 / Kimi / OpenAI 均可）
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 工作区：所有 read/write/edit/bash 都被限制在这个目录内
AGENT_WORKSPACE=./workspace

# 单轮最多推理步数
AGENT_MAX_STEPS=24

# bash 默认超时（秒）
AGENT_BASH_TIMEOUT=30

# read 默认单次最多返回行数（超出需翻页）
AGENT_MAX_READ_LINES=400

# 单条工具输出最大字符数（超出截断）
AGENT_MAX_OUTPUT_CHARS=20000

# 没有 Key 时设为 1：使用离线假模型跑通全链路（不发网络请求）
AGENT_MOCK=0
